# Copy to backend/.env and fill in real values. Never commit .env.

# ---------- App ----------
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8081
APP_SCHEME=around-you
# Comma-separated. Use exact origins in production — never "*".
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------- Postgres (Supabase) ----------
# Supabase > Project Settings > Database > Connection string > Shared pooler.
# Port 6543 = transaction pooler. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ---------- Auth ----------
# Auth is PASSWORDLESS: email one-time codes, or Google via Supabase. There is no
# password endpoint, and no PASSWORD_MIN_LENGTH to set for sign-in.
#
# Guards /api/admin/*. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
SESSION_TTL_DAYS=30
# Accounts promoted to `superadmin` automatically, comma-separated. This is the
# bootstrap — only a superadmin can grant the role, so someone has to be first.
# Applied on every sign-in, so this file is the source of truth.
SUPER_ADMIN_EMAILS=aakashdhanyamraju425@gmail.com

# ---------- Email OTP ----------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Wrong guesses per code before it is burned. Counted in Postgres, not Redis:
# the Redis limiter fails open and a 6-digit code is only ~10^6 attempts.
OTP_MAX_ATTEMPTS=5
# Codes one address may request per window, so this is not a free mail cannon.
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# ---------- Supabase Auth (Google sign-in) ----------
# Only the OAuth handshake runs through Supabase; the access token it returns is
# verified server-side and exchanged for one of our own session tokens.
#
# Setup: Supabase dashboard -> Authentication -> Providers -> enable Google (needs
# a Google Cloud OAuth client), then add your redirect URL under URL Configuration.
# Leave these blank and the Google button simply does not appear in the app.
SUPABASE_URL=
# Public by design — it ships in the app bundle and grants nothing on its own.
SUPABASE_ANON_KEY=

# ---------- AWS SES ----------
AWS_SES_REGION=ap-southeast-2
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Must be a verified SES identity (domain or single address).
SES_FROM_EMAIL=
SES_FROM_NAME=Around You
# With SES unset or sandboxed, the one-time code is written to the server log
# instead of sent. Outside production it also comes back in the API response as
# `dev_code`, so sign-in works without a mailbox.
EMAIL_DEV_MODE_LOG_LINKS=true

# ---------- Redis (cache + login rate limiting) ----------
# redis://default:<password>@<host>:<port>/0   (use rediss:// for TLS endpoints)
REDIS_URL=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120

# ---------- Cloudinary ----------
# Cloud name is on the Cloudinary dashboard header — it is NOT the API key name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=around-you

# ---------- Seed ----------
# Destructive: replaces all creators/posts with the demo dataset. Keep false.
SEED_ON_STARTUP=false
