# Copy to frontend/.env. Only EXPO_PUBLIC_* variables reach the app bundle.
#
# WARNING: these values are compiled into the JavaScript bundle and are visible
# to anyone using the app. Never put a secret here — no API secrets, no admin
# key. The admin key is typed in at runtime on the /admin screen instead.
#
# Env vars are inlined at build time: restart the dev server after changing them.

# Base URL of the backend, with no trailing slash and no /api suffix.
#   Web / iOS simulator : http://localhost:8000
#   Android emulator    : http://10.0.2.2:8000
#   Physical device     : http://<your-LAN-ip>:8000
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
