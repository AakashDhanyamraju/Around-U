{
  "expo": {
    "name": "Around You",
    "slug": "around-you",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "around-you",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aroundyou.app"
    },
    "android": {
      "package": "com.aroundyou.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF4EB"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF4EB"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Around You uses your photos so you can add one to a spot."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Around You uses your location to sort spots by how far away they are."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
